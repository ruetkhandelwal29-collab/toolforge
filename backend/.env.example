# ─────────────────────────────────────────────
# ToolForge — Backend Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────

# ── Server ───────────────────────────────────
PORT=4000
NODE_ENV=development
# URL of the frontend (used for CORS allow-list)
FRONTEND_URL=http://localhost:5173

# ── Supabase ─────────────────────────────────
# Find these in: Supabase Dashboard → Project → Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
# service_role key — has full DB access. KEEP SECRET. Never expose to browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
# anon key — safe for client-side. Still keep out of git.
SUPABASE_ANON_KEY=your-anon-key-here

# ── PostgreSQL Direct Connection ─────────────
# Find in: Supabase Dashboard → Project → Settings → Database → Connection string → URI
# Use the "Session mode" (port 5432) connection string.
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.your-project-ref.supabase.co:5432/postgres

# ── AI Providers ─────────────────────────────
# Google Gemini — get key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here
# OpenAI — optional, provider is stubbed. Leave blank for now.
OPENAI_API_KEY=

# ── Platform ─────────────────────────────────
# Fraction of each paid transaction taken as platform fee (0.20 = 20%)
PLATFORM_COMMISSION_RATE=0.20
