# ─────────────────────────────────────────────
# ToolForge — Frontend Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# Only variables prefixed with VITE_ are exposed to the browser.
# ─────────────────────────────────────────────

# ── Supabase (browser-side auth only) ────────
# Find in: Supabase Dashboard → Project → Settings → API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# Use the anon/public key ONLY — never the service_role key here
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ── Backend API ───────────────────────────────
# URL of the running backend server
VITE_API_URL=http://localhost:4000
